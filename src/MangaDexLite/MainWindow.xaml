<Window
    x:Class="MangaDexLite.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:core="using:MangaDexLite.Core"
    Title="MangaDex Lite">
    <Window.SystemBackdrop><MicaBackdrop /></Window.SystemBackdrop>
    <Grid x:Name="Root" Padding="24,12,24,20" RowSpacing="16" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <Grid.Resources><SolidColorBrush x:Key="AccentBrush" Color="#FF6746E8" /></Grid.Resources>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid ColumnSpacing="12">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                <Border Background="{StaticResource AccentBrush}" CornerRadius="10" Width="40" Height="40"><FontIcon Glyph="&#xE8F1;" Foreground="White" FontSize="21" /></Border>
                <StackPanel><TextBlock Text="MangaDex Lite" FontSize="22" FontWeight="SemiBold" /><TextBlock Text="Найти. Выбрать перевод. Сохранить." Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12" /></StackPanel>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <Button Content="Translation Studio" Click="OpenStudio_Click" />
                <Button Content="Открыть MangaDex ↗" Click="OpenSite_Click" />
            </StackPanel>
        </Grid>
        <Grid Grid.Row="1" ColumnSpacing="10">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <TextBox x:Name="SearchBox" PlaceholderText="Название манги / манхвы или ссылка mangadex.org/title/…" KeyDown="SearchBox_KeyDown" AutomationProperties.Name="Название или ссылка MangaDex" />
            <Button x:Name="SearchButton" Grid.Column="1" Content="Найти" Click="Search_Click" Style="{StaticResource AccentButtonStyle}" MinWidth="100" />
        </Grid>
        <Grid Grid.Row="2" ColumnSpacing="20">
            <Grid.ColumnDefinitions><ColumnDefinition Width="280" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
            <Border BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="12" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                <Grid RowSpacing="8" Padding="8">
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                    <TextBlock Text="РЕЗУЛЬТАТЫ ПОИСКА" Margin="8" FontSize="11" CharacterSpacing="90" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <ListView x:Name="ResultsList" Grid.Row="1" SelectionChanged="Results_SelectionChanged" SelectionMode="Single" HorizontalContentAlignment="Stretch">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="core:Manga">
                                <Grid Padding="0,6" ColumnSpacing="10">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="44" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <Border CornerRadius="5" Width="44" Height="62" Background="{ThemeResource ControlFillColorSecondaryBrush}"><Image Source="{x:Bind CoverUrl}" Stretch="UniformToFill" /></Border>
                                    <TextBlock Grid.Column="1" Text="{x:Bind Title}" TextWrapping="Wrap" MaxLines="3" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" FontWeight="SemiBold" />
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                    <Button x:Name="MoreButton" Grid.Row="2" Content="Ещё результаты" Click="More_Click" HorizontalAlignment="Stretch" IsEnabled="False" />
                </Grid>
            </Border>
            <Grid Grid.Column="1" RowSpacing="12">
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                <StackPanel Spacing="5">
                    <TextBlock x:Name="MangaTitle" Text="Ваша следующая история" FontSize="25" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                    <TextBlock x:Name="MangaDescription" Text="Найдите тайтл слева, затем выберите язык, группу перевода и нужные главы." MaxLines="3" TextTrimming="CharacterEllipsis" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>
                <Grid Grid.Row="1" ColumnSpacing="12">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="175" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <ComboBox x:Name="LanguageBox" Header="Язык перевода" DisplayMemberPath="Name" SelectedValuePath="Id" HorizontalAlignment="Stretch" SelectionChanged="Language_SelectionChanged" />
                    <ComboBox x:Name="GroupBox" Grid.Column="1" Header="Группа перевода" DisplayMemberPath="Name" SelectedValuePath="Id" HorizontalAlignment="Stretch" SelectionChanged="Group_SelectionChanged" />
                </Grid>
                <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="8">
                    <Button Content="Выбрать все" Click="SelectAll_Click" /><Button Content="Снять" Click="ClearSelection_Click" />
                    <TextBox x:Name="RangeFrom" Width="62" PlaceholderText="От" AutomationProperties.Name="Первая глава" />
                    <TextBox x:Name="RangeTo" Width="62" PlaceholderText="До" AutomationProperties.Name="Последняя глава" />
                    <Button Content="Диапазон" Click="Range_Click" /><TextBlock x:Name="SelectionCount" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>
                <Border Grid.Row="3" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="12" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                    <Grid>
                        <ListView x:Name="ChaptersList" SelectionMode="Multiple" IsMultiSelectCheckBoxEnabled="True" SelectionChanged="Chapters_SelectionChanged" HorizontalContentAlignment="Stretch">
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="core:Chapter">
                                    <StackPanel Padding="0,6" Spacing="3">
                                        <TextBlock Text="{x:Bind Label}" TextTrimming="CharacterEllipsis" FontWeight="SemiBold" />
                                        <TextBlock Text="{x:Bind Details}" TextTrimming="CharacterEllipsis" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    </StackPanel>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                        <TextBlock x:Name="EmptyHint" Text="Здесь появятся главы выбранного тайтла" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </Grid>
                </Border>
            </Grid>
        </Grid>
        <Border Grid.Row="3" Padding="16" CornerRadius="12" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
            <Grid RowSpacing="12" ColumnSpacing="10">
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <TextBox x:Name="FolderBox" PlaceholderText="Папка для скачивания" AutomationProperties.Name="Папка для скачивания" />
                <Button Grid.Column="1" Content="Обзор…" Click="Browse_Click" /><Button Grid.Column="2" Content="Открыть папку" Click="OpenFolder_Click" />
                <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="20" VerticalAlignment="Center">
                    <CheckBox x:Name="CbzCheck" Content="Собрать CBZ" ToolTipService.ToolTip="CBZ для читалки; папка страниц также сохраняется для повторной загрузки" />
                    <CheckBox x:Name="SaverCheck" Content="Экономия трафика" ToolTipService.ToolTip="Сжатые страницы MangaDex вместо оригиналов" />
                </StackPanel>
                <Button x:Name="CancelButton" Grid.Row="1" Grid.Column="1" Content="Отменить" Click="Cancel_Click" IsEnabled="False" />
                <Button x:Name="DownloadButton" Grid.Row="1" Grid.Column="2" Content="Скачать выбранное" Click="Download_Click" Style="{StaticResource AccentButtonStyle}" IsEnabled="False" />
            </Grid>
        </Border>
        <StackPanel Grid.Row="4" Spacing="6">
            <ProgressBar x:Name="Progress" Minimum="0" Maximum="100" Value="0" Height="4" />
            <TextBlock x:Name="Status" Text="Готово к поиску · без аккаунта и дополнительных программ" TextWrapping="Wrap" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            <InfoBar x:Name="MessageBar" IsOpen="False" IsClosable="True" Severity="Error" />
        </StackPanel>
    </Grid>
</Window>
